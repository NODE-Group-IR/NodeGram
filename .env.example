# Copy to .env for local doctl deploys. Never commit .env.
# NODEGRAM_CLIENTS_B64 is base64 of clients JSON — not encryption.

NODEGRAM_CLIENTS_B64=eyJzY2hlbWFWZXJzaW9uIjoxLCJjbGllbnRzIjpbXX0=
NODEGRAM_REQUEST_TIMEOUT_MS=20000
NODEGRAM_MAX_BODY_BYTES=768000
NODEGRAM_ALLOWED_ORIGINS=
NODEGRAM_BURST=30
NODEGRAM_REFILL_PER_SECOND=5
NODEGRAM_LOG_BOT_ALIAS=false
NODEGRAM_BUILD_ID=local-dev
