# Copy to .env for local doctl deploys. Never commit .env.
# NODEGRAM_CLIENTS_B64 is base64 of gateway client key hashes — not encryption.
# Telegram bot tokens are NOT stored here; callers send them per request as JSON "token".

NODEGRAM_CLIENTS_B64=eyJzY2hlbWFWZXJzaW9uIjoxLCJjbGllbnRzIjpbXX0=
NODEGRAM_REQUEST_TIMEOUT_MS=20000
NODEGRAM_MAX_BODY_BYTES=768000
# Use "none" to disable CORS — doctl cannot template empty strings
NODEGRAM_ALLOWED_ORIGINS=none
NODEGRAM_BURST=30
NODEGRAM_REFILL_PER_SECOND=5
# off | 0 | false disables the best-effort in-memory limiter
NODEGRAM_RATE_LIMIT=off
# true logs numeric Telegram bot id only (never the token secret)
NODEGRAM_LOG_BOT_ID=false
NODEGRAM_BUILD_ID=local-dev
